{
  "name": "@stashbase/llm-guard",
  "version": "0.0.1",
  "description": "TypeScript SDK for detecting API keys, tokens, and other secrets in LLM prompts, completions, and AI workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stashbase/llm-guard.git"
  },
  "homepage": "https://github.com/stashbase/llm-guard#readme",
  "bugs": {
    "url": "https://github.com/stashbase/llm-guard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "build": "tsup --config tsup.config.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "llm",
    "ai",
    "llm-security",
    "ai-security",
    "prompt",
    "prompt-security",
    "secret",
    "secrets",
    "secret-scanning",
    "api-key",
    "security",
    "guardrails",
    "stashbase"
  ],
  "author": "Stashbase",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "dotenv": "^17.4.2",
    "eslint": "10.6.0",
    "openai": "^6.45.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
